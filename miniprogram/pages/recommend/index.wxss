.hint {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--c-text-3);
  background: rgba(200, 160, 99, 0.1);
  border-radius: var(--r-sm);
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
  line-height: 1.5;
}
.hint-icon { margin-right: 10rpx; }

.book { display: flex; }
.cover {
  width: 140rpx;
  height: 190rpx;
  border-radius: 10rpx;
  margin-right: 22rpx;
  flex: none;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cover-img { width: 100%; height: 100%; }
.cover-text { color: #fff; font-size: 56rpx; font-weight: 600; }
.info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.title { font-size: 30rpx; font-weight: 600; margin-bottom: 6rpx; }
.author { font-size: 26rpx; color: var(--c-text-2); margin-bottom: 12rpx; }
.meta { display: flex; flex-wrap: wrap; margin-bottom: 12rpx; }
.reason {
  font-size: 24rpx;
  color: var(--c-primary-2);
  background: rgba(43, 91, 132, 0.06);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  align-self: flex-start;
}
.loading { text-align: center; color: var(--c-text-3); font-size: 26rpx; padding: 30rpx 0; }
.foot { padding: 20rpx 0 40rpx; }
.foot-tip { text-align: center; font-size: 24rpx; color: var(--c-text-3); margin-top: 16rpx; }
