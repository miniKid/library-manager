.page {
  padding-bottom: 140rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.search-icon { margin-right: 12rpx; font-size: 30rpx; }
.search-input { flex: 1; font-size: 28rpx; }
.search-clear { color: #C0C4CC; padding: 8rpx 0 8rpx 16rpx; font-size: 28rpx; }

/* 可借筛选 */
.filter-bar {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  padding: 24rpx;
  box-sizing: border-box;
}
.filter-item {
  flex-shrink: 0;
  padding: 10rpx 30rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #555;
  border: 1rpx solid transparent;
}
.filter-active {
  background: #2B5B84;
  color: #fff;
}

/* 图书卡片 */
.book-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.book-cover {
  width: 120rpx;
  height: 160rpx;
  border-radius: 10rpx;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.book-cover-text { color: #fff; font-size: 48rpx; font-weight: 600; }
.book-cover-img image { width: 120rpx; height: 160rpx; }
.book-info { flex: 1; min-width: 0; }
.book-title { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.book-author { font-size: 24rpx; color: #999; margin-bottom: 12rpx; }
.book-meta { display: flex; align-items: center; }

.book-stocks {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.stock-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 38rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  line-height: 1;
  border-radius: 8rpx;
  margin-right: 12rpx;
  box-sizing: border-box;
}

.stock-chip-on {
  color: #4a7dff;
  background: #eef3ff;
}

.stock-chip-off {
  color: #b0b3bf;
  background: #f4f5f7;
}
.book-arrow { color: #C0C4CC; font-size: 40rpx; padding-left: 12rpx; }

/* 加载更多 */
.load-more {
  text-align: center;
  color: #B0B4BC;
  font-size: 24rpx;
  padding: 24rpx 0;
}

/* 底部登录提示 */
.login-tip {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 100rpx;
  margin: 0 24rpx;
  background: #2B5B84;
  color: #fff;
  border-radius: 40rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(43, 91, 132, 0.35);
}
.login-tip-btn {
  background: #fff;
  color: #2B5B84;
  border-radius: 32rpx;
  padding: 8rpx 28rpx;
  font-size: 26rpx;
  font-weight: 600;
}

/* ===== 为你推荐 ===== */
.rec { padding: 0 0 8rpx; }
.rec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 24rpx 14rpx;
}
.rec-title { font-size: 30rpx; font-weight: 600; color: var(--c-primary); }
.rec-more { font-size: 24rpx; color: var(--c-text-3); }
.rec-scroll { white-space: nowrap; padding: 0 12rpx; }
.rec-item {
  display: inline-block;
  width: 190rpx;
  margin: 0 12rpx;
  vertical-align: top;
}
.rec-cover {
  width: 190rpx;
  height: 250rpx;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-card);
}
.rec-img { width: 100%; height: 100%; }
.rec-initial { color: #fff; font-size: 60rpx; font-weight: 600; }
.rec-name { font-size: 25rpx; margin-top: 10rpx; }
.rec-reason { font-size: 21rpx; color: var(--c-primary-2); margin-top: 4rpx; }

/* ===== 首页弹窗公告 ===== */
.popup-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 48rpx;
  box-sizing: border-box;
}
.popup-wrap {
  width: 100%;
  max-width: 620rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.popup-card {
  width: 100%;
  max-height: 72vh;
  background: #fff;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.3);
}
.popup-card-text {
  background: linear-gradient(165deg, #ffffff 0%, #eaf3fa 55%, #dfeef8 100%);
  border-top: 6rpx solid #2B5B84;
}
.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  padding: 32rpx 32rpx 8rpx;
}
.popup-title-center {
  text-align: center;
  padding: 36rpx 32rpx 20rpx;
  position: relative;
}
.popup-title-center::after {
  content: '';
  display: block;
  width: 64rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #4A8DB8, #2B5B84);
  margin: 16rpx auto 0;
}
.popup-body {
  flex: 1;
  height: 58vh;
  padding: 16rpx 32rpx;
  box-sizing: border-box;
}
.popup-card-text .popup-body { text-align: center; }
.popup-body-flush { padding: 0; }
.popup-image { width: 100%; display: block; }
.popup-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
  padding: 16rpx 0 32rpx;
}
.popup-cta {
  margin-top: 36rpx;
  width: 72%;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 52rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #fff;
  background: linear-gradient(90deg, #4A8DB8, #2B5B84);
  box-shadow: 0 10rpx 28rpx rgba(43, 91, 132, 0.45);
}
.popup-close {
  margin-top: 30rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.65);
  color: #fff;
  font-size: 30rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
