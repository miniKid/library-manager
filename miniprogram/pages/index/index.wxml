<view class="page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      placeholder="搜索书名 / 作者 / ISBN"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      bindconfirm="onSearch"
      confirm-type="search"
    />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="onClearKeyword">✕</text>
  </view>

  <!-- 馆藏地点可借筛选 -->
  <view class="filter-bar">
    <view
      class="filter-item {{activeLocation === '' ? 'filter-active' : ''}}"
      data-loc=""
      bindtap="onFilter"
    >全部</view>
    <view
      wx:for="{{locations}}"
      wx:key="*this"
      class="filter-item {{activeLocation === item ? 'filter-active' : ''}}"
      data-loc="{{item}}"
      bindtap="onFilter"
    >{{item}}可借</view>
  </view>

  <!-- 为你推荐（搜索/筛选时隐藏，避免干扰结果） -->
  <view class="rec" wx:if="{{recommends.length && !keyword && !activeLocation}}">
    <view class="rec-head">
      <text class="rec-title">✨ 为你推荐</text>
      <text class="rec-more" bindtap="goRecommend">更多 ›</text>
    </view>
    <scroll-view class="rec-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="rec-item" wx:for="{{recommends}}" wx:key="_id" data-id="{{item._id}}" bindtap="goDetail">
        <view class="rec-cover" style="background: {{item.coverBg}}">
          <image wx:if="{{item.cover}}" class="rec-img" src="{{item.cover}}" mode="aspectFill" lazy-load />
          <text wx:else class="rec-initial">{{item.initial}}</text>
        </view>
        <view class="rec-name ellipsis">{{item.title}}</view>
        <view class="rec-reason ellipsis">{{item.reason}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 图书列表 -->
  <view class="container" wx:if="{{books.length > 0}}">
    <view
      wx:for="{{books}}"
      wx:key="_id"
      class="book-card"
      data-id="{{item._id}}"
      bindtap="goDetail"
    >
      <view class="book-cover" style="background: {{item.coverBg}}">
        <view wx:if="{{item.cover}}" class="book-cover-img">
          <image src="{{item.cover}}" mode="aspectFill" lazy-load />
        </view>
        <text wx:else class="book-cover-text">{{item.coverChar}}</text>
      </view>
      <view class="book-info">
        <view class="book-title ellipsis">{{item.title}}</view>
        <view class="book-author ellipsis">{{item.author}}</view>
        <view class="book-meta">
          <view class="tag tag-blue">{{item.category}}</view>
          <view class="tag {{item.status === 'available' ? 'tag-green' : (item.status === 'unstocked' ? 'tag-gray' : 'tag-red')}}}">{{item.status === 'available' ? '可借' : (item.status === 'unstocked' ? '待配馆藏' : '借出')}}</view>
        </view>
        <view class="book-stocks" wx:if="{{item.stockChips && item.stockChips.length}}">
          <text
            wx:for="{{item.stockChips}}"
            wx:key="loc"
            class="stock-chip {{item.num > 0 ? 'stock-chip-on' : 'stock-chip-off'}}"
          >{{item.loc}} {{item.num}}</text>
        </view>
      </view>
      <view class="book-arrow">›</view>
    </view>

    <!-- 加载状态 -->
    <view class="load-more" wx:if="{{books.length > 0}}">
      <text wx:if="{{loading}}">加载中...</text>
      <text wx:elif="{{finished}}">— 已加载全部 {{total}} 本 —</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:elif="{{!loading}}">
    <view class="empty-icon">📚</view>
    <view>没有找到相关图书</view>
  </view>

  <!-- 未登录提示 -->
  <view wx:if="{{!logged}}" class="login-tip safe-bottom" bindtap="goLogin">
    <text>登录后可在线借阅图书</text>
    <text class="login-tip-btn">去登录</text>
  </view>

  <!-- 首页弹窗公告 -->
  <view wx:if="{{homePopup}}" class="popup-mask" catchtap="onPopupKnow" catchtouchmove="noop">
    <view class="popup-wrap" catchtap="noop">
      <view class="popup-card {{homePopup.type === 'text' ? 'popup-card-text' : ''}}">
        <view wx:if="{{homePopup.title}}" class="popup-title popup-title-center">{{homePopup.title}}</view>
        <scroll-view scroll-y class="popup-body {{homePopup.type === 'image' && !homePopup.title ? 'popup-body-flush' : ''}}">
          <image wx:if="{{homePopup.type === 'image'}}" class="popup-image" src="{{homePopup.image}}" mode="widthFix" bindtap="onPopupImageTap" />
          <rich-text wx:elif="{{homePopup.type === 'html'}}" nodes="{{homePopup.html}}"></rich-text>
          <text wx:else class="popup-text">{{homePopup.text}}</text>
        </scroll-view>
      </view>
      <view wx:if="{{homePopup.link}}" class="popup-cta" bindtap="onPopupDetail">{{homePopup.linkText || '查看详情'}}</view>
      <view class="popup-close" bindtap="onPopupKnow">✕</view>
    </view>
  </view>
</view>
