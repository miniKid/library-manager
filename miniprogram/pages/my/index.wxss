@import "./borrow.wxss";

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #2B5B84 0%, #1F3A5F 100%);
  border-radius: var(--r-lg);
  padding: 44rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-float);
  position: relative;
  overflow: hidden;
}
.user-card::after {
  content: '';
  position: absolute;
  right: -70rpx;
  top: -70rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(200, 160, 99, 0.20) 0%, rgba(200, 160, 99, 0) 70%);
}
.user-card.unlogged { background: var(--c-surface); box-shadow: var(--shadow-card); }
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  border: 4rpx solid rgba(200, 160, 99, 0.85);
  box-shadow: 0 0 0 6rpx rgba(200, 160, 99, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.avatar-img { width: 120rpx; height: 120rpx; }
.avatar-gray { background: #ECE6DA; }
.avatar-text { color: #fff; font-size: 44rpx; font-weight: 600; }
.avatar-gray .avatar-text { color: var(--c-text-2); }
.user-info { flex: 1; min-width: 0; }
.nickname { color: #fff; font-size: 34rpx; font-weight: 600; margin-bottom: 0; line-height: 1.2; letter-spacing: 1rpx; }
.unlogged .nickname { color: var(--c-text); }
.unlogged-tip { color: var(--c-text-3); font-size: 26rpx; }
.role-tag .tag { margin: 0; }
.user-name-row { display: flex; align-items: center; gap: 14rpx; }
.user-card .role-tag .tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 38rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  line-height: 1;
  background: rgba(255, 255, 255, 0.16);
  color: #F4E6CA;
  border: 1rpx solid rgba(200, 160, 99, 0.55);
}
.admin-entry {
  color: var(--c-accent);
  font-size: 26rpx;
  padding: 12rpx 0 12rpx 20rpx;
  font-weight: 500;
}

/* 借阅区块 / 借书卡片样式见 borrow.wxss（与「完整借阅记录」页共享） */

/* 退出登录 */
.logout {
  text-align: center;
  color: var(--c-danger);
  font-size: 30rpx;
  background: var(--c-surface);
  border-radius: var(--r-md);
  padding: 28rpx 0;
  margin-top: 40rpx;
}

/* 修改资料：头像选择（与登录页一致） */
.edit-avatar-row { margin-top: 20rpx; }
.avatar-row {
  display: flex;
  justify-content: center;
  margin-bottom: 36rpx;
}
.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 0;
  background: #F2F4F7;
  overflow: hidden;
  border: 2rpx dashed #C0C4CC;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-btn::after { border: none; }
.avatar-img { width: 160rpx; height: 160rpx; }
.avatar-placeholder { display: flex; flex-direction: column; align-items: center; }
.avatar-plus { font-size: 48rpx; color: #B0B4BC; line-height: 1; }
.avatar-tip { font-size: 22rpx; color: #B0B4BC; margin-top: 8rpx; }

/* 修改借阅地址：未归还提示 */
.apply-warn {
  font-size: 24rpx;
  color: var(--c-danger);
  background: rgba(192, 57, 43, 0.08);
  border-radius: var(--r-sm);
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

/* 还书日期选择弹窗 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}
.date-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--c-surface);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
  max-height: 75vh;
}
.date-sheet-head {
  padding: 28rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #f0f2f5;
}
.date-sheet-title {
  font-size: 32rpx;
  font-weight: 600;
}
.date-sheet-loc {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}
/* 月历：月份导航 */
.cal-head {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx 0;
}
.cal-nav {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #666;
}
.cal-nav-dis {
  color: #d5d9e0;
}
.cal-title {
  min-width: 240rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}
/* 月历：星期头部 */
.cal-week-head {
  display: flex;
  padding: 8rpx 24rpx 0;
}
.cal-week-cell {
  width: calc(100% / 7);
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 0;
}
/* 月历：日期网格 */
.cal-scroll {
  max-height: 44vh;
  padding: 8rpx 24rpx;
  box-sizing: border-box;
}
.cal-grid {
  display: flex;
}
.cal-cell {
  width: calc(100% / 7);
  height: 96rpx;
  border-radius: 14rpx;
  margin: 4rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
}
.cal-empty {
  background: transparent;
}
.cal-day {
  font-size: 30rpx;
  line-height: 1.2;
}
.cal-avail {
  background: #E7F2EC;
  color: var(--c-success);
}
.cal-dis {
  background: #f4f5f7;
  color: #c0c4cc;
}
.cal-out {
  background: transparent;
  color: #d5d9e0;
}
.cal-sel {
  background: var(--c-primary);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(31, 58, 95, 0.3);
}
.cal-sel .cal-day {
  color: #fff;
}
/* 今天圆点标记 */
.cal-today {
  position: absolute;
  top: 8rpx;
  right: 10rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: transparent;
}
.cal-today-show {
  background: #07c160;
}
.cal-sel .cal-today-show {
  background: #fff;
}
/* 图例 */
.cal-legend {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 16rpx 32rpx 0;
}
.cal-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #666;
}
.cal-legend-box {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
}
.box-avail {
  background: #e8f7ee;
  border: 1rpx solid #07c160;
}
.box-dis {
  background: #f4f5f7;
  border: 1rpx solid #d0d3da;
}
.box-out {
  background: transparent;
  border: 1rpx solid #e5e7eb;
}
.date-sheet-foot {
  padding: 20rpx 32rpx 32rpx;
  border-top: 1rpx solid #f0f2f5;
}
.date-selected {
  font-size: 28rpx;
  color: #07c160;
  margin-bottom: 20rpx;
}
.date-selected-empty {
  color: #999;
}
.date-sheet-actions {
  display: flex;
  gap: 20rpx;
}
.date-sheet-actions button {
  flex: 1;
  margin: 0;
}
.btn-plain {
  background: #fff;
  color: var(--c-text);
  border: 1rpx solid var(--c-line);
  border-radius: var(--r-md);
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
}
.btn-primary {
  background: var(--c-primary);
  color: #fff;
  border-radius: var(--r-md);
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
}
.btn-primary[disabled] {
  background: #AEBED0;
  color: #fff;
}

/* 借书证状态卡：暖金会员卡质感，区别于顶部深蓝用户卡与白色借阅卡 */
.card-status {
  padding: 32rpx 28rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(135deg, #F8EBD0 0%, #E9CD92 100%);
  border: 1rpx solid rgba(200, 160, 99, 0.5);
  box-shadow: 0 8rpx 28rpx rgba(200, 160, 99, 0.25);
  position: relative;
  overflow: hidden;
}
.card-status::after {
  content: '';
  position: absolute;
  right: -70rpx;
  top: -70rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 70%);
}
.card-status-head {
  position: relative;
  z-index: 1;
  margin-bottom: 14rpx;
}
.card-status-head .tag {
  margin: 0;
}
.card-status-desc {
  position: relative;
  z-index: 1;
  font-size: 26rpx;
  color: #5A4321;
  line-height: 1.7;
}
.card-status .borrow-actions {
  position: relative;
  z-index: 1;
  border-top: none;
  padding-top: 20rpx;
  margin-top: 20rpx;
}
.card-status .return-btn {
  background: #6B4E2E;
  color: #FCF3DA;
  border: none;
}

/* 借书证申请表单 */
.apply-form {
  padding: 28rpx 32rpx 4rpx;
}
.apply-picker {
  display: block;
  width: 100%;
}
.apply-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.apply-label {
  width: 260rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
  white-space: nowrap;
}
.apply-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding: 8rpx 0;
}
.apply-input-ph {
  color: #bbb;
}
.apply-picker {
  padding: 8rpx 0;
}
.apply-tip {
  font-size: 24rpx;
  color: #999;
  padding: 16rpx 32rpx 0;
  line-height: 1.6;
}
