.page { padding: 24rpx; }

/* 非管理员 */
.forbid { padding-top: 160rpx; }
.forbid-btn { width: 320rpx; margin: 0 auto; }

/* 统计卡片 */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 32rpx;
}
.stat-card {
  width: calc(50% - 12rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 0;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.stat-card:nth-child(odd) { margin-right: 24rpx; }
.stat-num { font-size: 52rpx; font-weight: 700; }
.stat-label { font-size: 24rpx; color: #999; margin-top: 8rpx; }

/* 快捷入口 */
.menu-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.menu-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.menu-body { flex: 1; min-width: 0; }
.menu-title { font-size: 30rpx; font-weight: 600; }
.menu-sub { font-size: 24rpx; color: #999; margin-top: 6rpx; }
.menu-arrow { color: #C0C4CC; font-size: 40rpx; }
