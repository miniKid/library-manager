<view class="container">
  <view class="card">
    <view class="section-title">首页弹窗公告<text class="tip">（登录用户打开首页时弹出；保存即更新，已关闭的用户会重新看到）</text></view>
    <view class="form-item">
      <text class="form-label">启用</text>
      <switch checked="{{popup.enabled}}" bindchange="onPopupToggle" />
    </view>
    <view class="form-item">
      <text class="form-label">类型</text>
      <view class="scope-row">
        <view wx:for="{{popupTypes}}" wx:key="value" class="chip {{popupTypeIndex === index ? 'chip-on' : ''}}" data-idx="{{index}}" bindtap="onPopupType">{{item.label}}</view>
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">标题</text>
      <input class="form-input" maxlength="30" placeholder="可选，最多30字" value="{{popup.title}}" data-field="title" bindinput="onPopupInput" />
    </view>
    <block wx:if="{{popup.type === 'text'}}">
      <view class="form-item form-item-area">
        <text class="form-label">文字内容</text>
        <textarea class="form-area" maxlength="500" placeholder="纯文字公告内容" value="{{popup.text}}" data-field="text" bindinput="onPopupInput" />
      </view>
    </block>
    <block wx:elif="{{popup.type === 'image'}}">
      <view class="form-item form-item-area">
        <text class="form-label">海报图片地址</text>
        <textarea class="form-area" maxlength="2000" placeholder="cloud:// 文件ID / https 外链 / 包内路径" value="{{popup.image}}" data-field="image" bindinput="onPopupInput" />
      </view>
      <view class="tip">云存储权限无法修改时，请改用下方「选择图片」（图片随配置入库，不依赖云存储）</view>
      <view class="form-item">
        <text class="form-label">或选择图片</text>
        <view class="popup-image-actions">
          <button class="mini-btn" size="mini" bindtap="onChoosePopupImage">选择图片</button>
          <button wx:if="{{popup.imageBase64}}" class="mini-btn" size="mini" bindtap="onClearPopupImage">移除</button>
        </view>
      </view>
      <view wx:if="{{popupImagePreview}}" class="popup-image-preview">
        <image src="{{popupImagePreview}}" mode="widthFix" binderror="onPopupPreviewError" />
      </view>
      <view wx:if="{{popup.imageBase64}}" class="tip">已使用本地图片（随配置存入数据库，不依赖云存储权限），优先于上方图片地址，保存后生效</view>
    </block>
    <view class="form-item">
      <text class="form-label">点击跳转</text>
      <picker class="form-value" range="{{popupLinks}}" range-key="label" value="{{popupLinkIndex}}" bindchange="onPopupLink">
        <view class="picker-value">{{popupLinks[popupLinkIndex].label}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">跳转键文字</text>
      <input class="form-input" maxlength="8" placeholder="查看详情" value="{{popup.linkText}}" data-field="linkText" bindinput="onPopupInput" />
    </view>
    <button class="btn-primary send-btn" loading="{{savingPopup}}" bindtap="onSavePopup">保存弹窗配置</button>
  </view>
</view>
