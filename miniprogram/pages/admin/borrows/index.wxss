.page { padding: 24rpx; }

/* 筛选栏：吸顶 + 单行横滑，不再等分七格 */
.filter-wrap {
  position: sticky;
  top: 0;
  z-index: 10;
  margin: -24rpx -24rpx 20rpx;
  padding: 16rpx 0 16rpx 24rpx;
  background: var(--c-bg);
}
/* 右缘渐隐，提示右边还有页签 */
.filter-wrap::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  width: 40rpx;
  background: linear-gradient(to right, rgba(247, 245, 240, 0), var(--c-bg) 75%);
  pointer-events: none;
}
.filter-scroll {
  width: 100%;
  white-space: nowrap;
}
.filter-bar {
  display: inline-flex;
  align-items: center;
  padding-right: 40rpx;
}
.chip {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  margin-right: 14rpx;
  border-radius: var(--r-pill);
  background: var(--c-surface);
  border: 1rpx solid var(--c-line);
  font-size: 26rpx;
  color: var(--c-text-2);
  line-height: 1.15;
}
.chip:last-child { margin-right: 0; }
.chip-on {
  background: var(--c-primary);
  border-color: var(--c-primary);
  color: #fff;
  font-weight: 500;
}
.chip-label { line-height: 1.15; }
.chip-num {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: var(--c-text-3);
  text-align: center;
}
.chip-num-danger { color: var(--c-danger); }
.chip-on .chip-num { color: rgba(255, 255, 255, 0.85); }

.borrow-item { padding: 24rpx; }
.borrow-head { margin-bottom: 14rpx; }
.borrow-title { font-size: 30rpx; font-weight: 600; margin-right: 16rpx; }
.borrow-row {
  font-size: 26rpx;
  color: #666;
  line-height: 1.9;
}
.borrow-actions {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F1F3;
}
.return-btn {
  display: inline-block;
  background: #2B5B84;
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
  padding: 10rpx 40rpx;
}
.remind-btn {
  display: inline-block;
  background: #E8552D;
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
  padding: 10rpx 40rpx;
}
.cancel-btn {
  display: inline-block;
  background: #fff;
  color: #666;
  font-size: 26rpx;
  border-radius: 32rpx;
  padding: 10rpx 40rpx;
  border: 1rpx solid #D0D3DA;
  margin-right: 16rpx;
}
