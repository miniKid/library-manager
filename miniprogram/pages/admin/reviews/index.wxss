.filters { display: flex; margin-bottom: 16rpx; }
.chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--c-text-2);
  font-size: 26rpx;
  border: 1rpx solid var(--c-line);
  margin-right: 16rpx;
}
.chip-on { background: rgba(43, 91, 132, 0.1); color: var(--c-primary-2); border-color: var(--c-primary-2); }
.search-btn { color: var(--c-primary-2); font-size: 26rpx; padding-left: 16rpx; }

.head { display: flex; align-items: center; margin-bottom: 10rpx; }
.name { font-size: 28rpx; font-weight: 500; margin-right: 16rpx; }
.stars { flex: 1; color: #E3E6EB; font-size: 22rpx; }
.star-on { color: var(--c-accent); }
.book { font-size: 24rpx; color: var(--c-text-3); margin-bottom: 8rpx; }
.content { font-size: 28rpx; line-height: 1.6; color: #333; }
.reply {
  margin-top: 14rpx;
  padding: 14rpx;
  background: rgba(200, 160, 99, 0.1);
  border-radius: var(--r-sm);
  font-size: 25rpx;
  color: var(--c-text-2);
  line-height: 1.6;
}
.foot { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.time { font-size: 22rpx; color: var(--c-text-3); }
.acts { display: flex; }
.act { font-size: 24rpx; color: var(--c-primary-2); margin-left: 24rpx; }
.act-danger { color: var(--c-danger); }
.more { text-align: center; font-size: 24rpx; color: var(--c-text-3); padding: 24rpx 0; }

.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 100;
}
.sheet-title { font-size: 32rpx; font-weight: 600; margin-bottom: 20rpx; }
.textarea {
  width: 100%;
  height: 180rpx;
  background: #F7F8FA;
  border-radius: var(--r-sm);
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.sheet-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.sheet-actions button { flex: 1; }
