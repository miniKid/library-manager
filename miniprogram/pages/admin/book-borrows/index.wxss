.page { padding: 24rpx; }
.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.filter {
  font-size: 26rpx;
  color: #666;
  background: #f4f5f7;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
}
.filter-on {
  background: #07c160;
  color: #fff;
}
.loading, .empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 80rpx 0;
}
.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.item-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.item-user { font-size: 30rpx; font-weight: 600; color: #333; }
.item-status {
  font-size: 24rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: #f4f5f7;
  color: #666;
}
.status-returned { background: #e8f7ee; color: #07c160; }
.status-borrowing { background: #e6f0ff; color: #2B5B84; }
.status-overdue { background: #fdecec; color: #e54d42; }
.status-pending { background: #fff4e6; color: #d9860b; }
.status-return_requested { background: #f0e9ff; color: #7b5bd6; }
.status-cancelled { background: #f4f5f7; color: #b0b3bf; }
.item-sub { font-size: 26rpx; color: #888; line-height: 1.7; }
