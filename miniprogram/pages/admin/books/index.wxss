.page { padding: 24rpx; }

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.search-icon { margin-right: 12rpx; font-size: 30rpx; }
.search-input { flex: 1; font-size: 28rpx; }
.search-clear { color: #C0C4CC; padding: 8rpx 0 8rpx 16rpx; font-size: 28rpx; }

.add-btn { margin-bottom: 24rpx; }

.retry-btn {
  margin-top: 20rpx;
  padding: 12rpx 48rpx;
  background: #4a7dff;
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 40rpx;
}

.book-item { display: flex; align-items: center; }
.book-cover {
  width: 100rpx;
  height: 136rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.cover-img { width: 100rpx; height: 136rpx; }
.cover-text { color: #fff; font-size: 40rpx; font-weight: 600; }
.book-info { flex: 1; min-width: 0; }
.book-title { font-size: 28rpx; font-weight: 600; margin-bottom: 6rpx; }
.book-author { font-size: 22rpx; color: #999; margin-bottom: 10rpx; }

.book-stocks {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}
.stock-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 38rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  line-height: 1;
  border-radius: 8rpx;
  margin-right: 12rpx;
  box-sizing: border-box;
  color: #4a7dff;
  background: #eef3ff;
}

.book-actions { margin-left: 12rpx; flex-shrink: 0; }
.act-btn {
  font-size: 24rpx;
  border-radius: 8rpx;
  padding: 8rpx 24rpx;
  text-align: center;
  margin-bottom: 12rpx;
}
.act-edit { background: #E8F1F8; color: #2B5B84; }
.act-del { background: #FDEBEA; color: #E54D42; }
.act-del:last-child { margin-bottom: 0; }

/* 触底加载提示 */
.load-more { text-align: center; padding: 24rpx 0; }
.lm-tip { font-size: 24rpx; color: #999; }
