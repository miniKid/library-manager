<view class="page safe-bottom">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      placeholder="搜索书名 / 作者 / ISBN"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onKeywordInput"
      bindconfirm="onSearch"
    />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="onClearKeyword">✕</text>
  </view>

  <!-- 新增按钮 -->
  <button class="btn-primary add-btn" bindtap="goAdd">＋ 新增图书</button>

  <view wx:if="{{loadError}}" class="card">
    <view class="empty">
      <view class="empty-icon">⚠️</view>
      <view>加载失败，请检查云环境配置或网络</view>
      <view class="retry-btn" bindtap="onRetry">重新加载</view>
    </view>
  </view>

  <block wx:elif="{{books.length === 0}}">
    <view wx:if="{{loading}}" class="card">
      <view class="empty">
        <view class="empty-icon">⏳</view>
        <view>加载中…</view>
      </view>
    </view>
    <view wx:else class="card">
      <view class="empty">
        <view class="empty-icon">📚</view>
        <view>{{keyword ? '未找到相关图书' : '暂无图书，点击上方按钮新增'}}</view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view wx:for="{{books}}" wx:key="_id" class="card book-item">
      <view class="book-cover" style="background: {{item.coverBg}}">
        <view wx:if="{{item.cover}}">
          <image src="{{item.cover}}" mode="aspectFill" class="cover-img" />
        </view>
        <text wx:else class="cover-text">{{item.coverChar}}</text>
      </view>
      <view class="book-info">
        <view class="book-title ellipsis">{{item.title}}</view>
        <view class="book-author ellipsis">{{item.author}}</view>
        <view class="book-stocks" wx:if="{{item.stockChips && item.stockChips.length}}">
          <text wx:for="{{item.stockChips}}" wx:key="loc" class="stock-chip">{{item.loc}} {{item.num}}</text>
        </view>
      </view>
      <view class="book-actions">
        <view class="act-btn act-edit" data-id="{{item._id}}" bindtap="goEdit">编辑</view>
        <view class="act-btn act-del" data-id="{{item._id}}" data-title="{{item.title}}" bindtap="onDelete">删除</view>
      </view>
    </view>
    <view class="load-more">
      <view wx:if="{{loading}}" class="lm-tip">加载中…</view>
      <view wx:elif="{{finished}}" class="lm-tip">没有更多了</view>
    </view>
  </block>
</view>
