.summary { display: flex; align-items: center; }
.summary-left {
  width: 210rpx;
  text-align: center;
  border-right: 1rpx solid var(--c-line);
  padding-right: 16rpx;
  flex: none;
}
.avg { font-size: 64rpx; font-weight: 600; color: var(--c-primary); line-height: 1.1; }
.avg-label { font-size: 22rpx; color: var(--c-text-3); margin-bottom: 8rpx; }
.stars { display: flex; justify-content: center; }
.star { color: #E3E6EB; font-size: 24rpx; }
.star-on { color: var(--c-accent); }
.count { font-size: 22rpx; color: var(--c-text-3); margin-top: 8rpx; }
.summary-right { flex: 1; padding-left: 20rpx; }
.dist-row { display: flex; align-items: center; margin-bottom: 8rpx; }
.dist-label { width: 60rpx; font-size: 22rpx; color: var(--c-text-3); }
.dist-bar { flex: 1; height: 10rpx; background: #F0F1F3; border-radius: 999rpx; overflow: hidden; }
.dist-fill { height: 100%; background: var(--c-accent); border-radius: 999rpx; }
.dist-num { width: 56rpx; text-align: right; font-size: 22rpx; color: var(--c-text-3); }

.toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.sorts { display: flex; }
.sort {
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  color: var(--c-text-2);
  background: #fff;
  border-radius: 999rpx;
  margin-right: 12rpx;
  border: 1rpx solid var(--c-line);
}
.sort-on { background: var(--c-primary); color: #fff; border-color: var(--c-primary); }
.write {
  font-size: 26rpx;
  color: #fff;
  background: var(--c-primary-2);
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
}

.review-head { display: flex; align-items: center; margin-bottom: 16rpx; }
.avatar { width: 64rpx; height: 64rpx; border-radius: 50%; margin-right: 16rpx; flex: none; }
.avatar-ph {
  background: rgba(43, 91, 132, 0.12);
  color: var(--c-primary-2);
  font-size: 28rpx;
  text-align: center;
  line-height: 64rpx;
}
.review-meta { flex: 1; min-width: 0; }
.review-name { font-size: 28rpx; font-weight: 500; }
.review-star { display: flex; align-items: center; margin-top: 4rpx; }
.star-sm { color: #E3E6EB; font-size: 22rpx; }
.review-time { color: var(--c-text-3); font-size: 22rpx; margin-left: 12rpx; }
.del { color: var(--c-danger); font-size: 24rpx; }

.review-content { font-size: 28rpx; line-height: 1.65; color: #333; }
.review-edited { font-size: 22rpx; color: var(--c-text-3); margin-top: 6rpx; }
.reply {
  margin-top: 16rpx;
  background: rgba(200, 160, 99, 0.1);
  border-radius: var(--r-sm);
  padding: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}
.reply-tag { color: var(--c-accent); font-weight: 500; margin-right: 12rpx; }
.reply-text { color: var(--c-text-2); }
.review-foot { display: flex; justify-content: flex-end; margin-top: 16rpx; }
.like {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--c-text-3);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--c-line);
}
.like-on { color: var(--c-primary-2); border-color: var(--c-primary-2); background: rgba(43, 91, 132, 0.06); }
.like-icon { margin-right: 6rpx; }

.more { text-align: center; color: var(--c-text-3); font-size: 26rpx; padding: 24rpx 0; }
.more-end { color: #C0C4CC; }

.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 100;
}
.sheet-title { font-size: 32rpx; font-weight: 600; margin-bottom: 20rpx; }
.rating-row { display: flex; align-items: center; margin-bottom: 20rpx; }
.star-lg { font-size: 56rpx; color: #E3E6EB; margin-right: 8rpx; }
.rating-tip { color: var(--c-text-3); font-size: 24rpx; margin-left: 12rpx; }
.textarea {
  width: 100%;
  height: 220rpx;
  background: #F7F8FA;
  border-radius: var(--r-sm);
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.anon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--c-text-2);
}
.sheet-actions { display: flex; gap: 20rpx; }
.sheet-actions button { flex: 1; }
